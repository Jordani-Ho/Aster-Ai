+// Community policy: whitelist applies to the authenticated connection, never an ephemeral wrap author.
+fn community_member(conn: &conn::ClientConn, settings: &Settings) -> bool {
+    match (conn.auth_pubkey(), &settings.authorization.pubkey_whitelist) {
+        (Some(key), Some(members)) => members.contains(key),
+        _ => false,
+    }
