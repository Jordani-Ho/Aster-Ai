+#[cfg(test)]
+mod community_onboarding_tests {
+ use super::*;
+ #[test] fn defaults_remain_closed_and_open_still_requires_auth() {
+  let mut settings=Settings::default();let conn=conn::ClientConn::default();
+  assert!(!settings.authorization.community_open);assert!(!community_member(&conn,&settings));
+  settings.authorization.community_open=true;assert!(!community_member(&conn,&settings));
+ }
+ #[test] fn public_filter_is_only_one_full_author_and_identity_slot() {
+  let sub=|value:serde_json::Value| serde_json::from_value::<crate::subscription::Subscription>(value).unwrap();
+  let author="a".repeat(64);
+  let good=sub(json!(["REQ","identity",{"kinds":[30078],"authors":[author],"#d":["aster.identity"]}]));assert!(public_identity_subscription(&good));
+  for value in [json!(["REQ","bad",{"kinds":[30078],"authors":["a".repeat(64)],"#d":["aster.backup.0"]}]),json!(["REQ","bad",{"kinds":[30078],"#d":["aster.identity"]}]),json!(["REQ","bad",{"kinds":[1059,30078],"authors":["a".repeat(64)],"#d":["aster.identity"]}])]{assert!(!public_identity_subscription(&sub(value)))}
+ }
