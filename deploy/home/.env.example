# 知衡内测部署的环境变量（第二版）。复制为 .env 后按注释填写；真实 .env 不进仓库。
# 用法：cp .env.example .env && chmod 600 .env

# ---- 模型网关（只作为使用者自己模型调用失败时的后备）----
# 上游 OpenAI 兼容服务的密钥；只放在 .env，不进仓库、不写进配置文件。
UPSTREAM_API_KEY=
# 后备根地址（不含 /v1）与模型；留空使用 providers.json 已核实的默认项。
UPSTREAM_BASE_URL=
UPSTREAM_MODEL=
# 仅控制用户接通自己的模型后调用失败的后备；对外前设 false 并重跑 setup.sh。
MODEL_FALLBACK_ENABLED=true
# 非清单服务商：需代理时填完整 HTTPS /chat/completions 地址，逗号分隔。
MODEL_PROXY_ALLOWED_URLS=

# ---- 推送（VAPID）----
# 联系邮箱，形如 mailto:you@example.com（web-push 要求）。
VAPID_SUBJECT=mailto:change-me@example.com
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY 由 ./setup.sh 自动生成并追加到 .env；不要手工提交。

# ---- 地址（无域名自测由 ./quick-start.sh 自动填；固定域名是下一步）----
# 只写域名不写协议；setup.sh 会生成 https://APP_DOMAIN、wss://RELAY_DOMAIN。
APP_DOMAIN=
RELAY_DOMAIN=
# 固定域名模式的 Cloudflare Zero Trust 隧道 token（下一步再用；临时隧道不需要）。
CF_TUNNEL_TOKEN=

# 内测中继开放模式：仍强制 NIP-42 认证，未认证连接不能读写消息。
# 第二版没有成员白名单，内测保持 true。
RELAY_COMMUNITY_OPEN=true
