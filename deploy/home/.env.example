# 知衡内测部署的环境变量。复制为 .env 后填写；真实 .env 不进仓库。
# 用法：cp .env.example .env && chmod 600 .env

# ---- 社区成员（可留空，用手机及一次性部署口令登记老师）----
# 兼容已有成员的后台编号，逗号或空格分隔；新成员用手机邀请，无需填写。
# 例：MEMBER_PUBKEYS=aaaa...64位,bbbb...64位
MEMBER_PUBKEYS=

# ---- 模型网关（内测失败后备）----
# 上游 OpenAI 兼容服务的密钥；只放在 .env，不进仓库、不写进配置文件。
UPSTREAM_API_KEY=
# 后备根地址（不含 /v1）与模型；留空使用 providers.json 已核实的 DeepSeek 默认项。
UPSTREAM_BASE_URL=
UPSTREAM_MODEL=
# 仅控制用户接通自己的模型后调用失败的后备；推广时设 false 并重跑 setup.sh。
MODEL_FALLBACK_ENABLED=true
# 非清单服务商：需代理时填完整 HTTPS /chat/completions 地址，逗号分隔。
MODEL_PROXY_ALLOWED_URLS=

# ---- 推送（VAPID）----
# 联系邮箱，形如 mailto:you@example.com（web-push 要求）。
VAPID_SUBJECT=mailto:change-me@example.com
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY 由 ./setup.sh 自动生成并追加到 .env；不要手工提交。

# ---- 域名模式（有域名时填；无域名用 ./quick-start.sh，脚本会自动覆盖这三项）----
# 应用、 中继、网关的域名，只写域名不写协议。setup.sh 会生成
# https://APP_DOMAIN、wss://RELAY_DOMAIN，并在 gateway 配置里使用 APP 源做 NIP-98 校验。
APP_DOMAIN=
RELAY_DOMAIN=
GATEWAY_DOMAIN=
# Cloudflare Zero Trust 隧道的 token（域名模式）；无域名模式不需要。
CF_TUNNEL_TOKEN=

# ---- 验收用自测成员（默认关闭；需要旧命令行探针时设1）----
# 1：setup.sh 会生成一对只用于验收的密钥（VERIFY_MEMBER_SECRET 追加到 .env），
#    并把它的公钥加入中继/网关成员名单；正式对外前改成 0 并重跑 setup.sh。
SELF_TEST_MEMBER=0

# 仅内测的中继开放模式：仍强制认证；网关仍按邀请成员放行。
RELAY_COMMUNITY_OPEN=true
