{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "lunar-typescript": ["./node_modules/lunar-typescript/dist/index.d.ts"] }
  },
  "include": ["src", "vite.config.ts", "../domain/tcm/bazi/**/*.ts"]
}
