{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "typeRoots": [
      "../app/node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "*.ts"
  ]
}
